<section class="section"><div class="container"><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.copy }}</p>{% form 'contact', class: 'form-grid js-loading-form' %}{% if form.posted_successfully? %}<p class="form-status field--full" role="status">Your message was sent.</p>{% endif %}{% if form.errors %}<div role="alert" class="field--full">{{ form.errors | default_errors }}</div>{% endif %}
{% render 'form-field', id: 'contact-name', label: 'Name', name: 'contact[name]', required: true %}{% render 'form-field', id: 'contact-email', label: 'Email', name: 'contact[email]', type: 'email', required: true %}
<div class="field"><label for="contact-type">Order type</label><select id="contact-type" name="contact[Order type]"><option>General question</option><option>Richardson 112 inquiry</option><option>Richardson PTS30 inquiry</option><option>Business branding inquiry</option><option>Bulk order inquiry</option></select></div>
{% render 'form-field', id: 'contact-phone', label: 'Phone', name: 'contact[Phone]', type: 'tel' %}{% render 'form-field', id: 'contact-message', label: 'Message', name: 'contact[body]', type: 'textarea', full: true, required: true %}<div class="field field--full"><button class="button" type="submit">Send Message</button></div>{% endform %}</div></section>
{% schema %}{"name":"Contact form","settings":[{"type":"text","id":"heading","label":"Heading","default":"Send the Details"},{"type":"textarea","id":"copy","label":"Copy","default":"Include product type, estimated quantity, deadline, artwork status and preferred model or material."}],"presets":[{"name":"Contact form"}]}{% endschema %}
