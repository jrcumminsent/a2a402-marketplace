<section class="section"><div class="container"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><div class="grid grid--3">{% for block in section.blocks %}<article class="media-card" {{ block.shopify_attributes }}>{% render 'responsive-image', image: block.settings.image, fallback_asset: block.settings.fallback, alt: block.settings.title, width: 1254, height: 1254 %}<div class="media-card__content"><h3>{{ block.settings.title }}</h3><p>{{ block.settings.copy }}</p><a href="{{ block.settings.url }}">{{ block.settings.label }} →</a></div></article>{% endfor %}</div></div></section>
{% schema %}{"name":"Accessory grid","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Branded goods"},{"type":"text","id":"heading","label":"Heading","default":"Accessories That Carry the Brand"}],"blocks":[{"type":"category","name":"Category","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"fallback","label":"Fallback asset filename","default":"accessories.png"},{"type":"text","id":"title","label":"Title"},{"type":"textarea","id":"copy","label":"Description"},{"type":"text","id":"label","label":"CTA label","default":"Shop or inquire"},{"type":"url","id":"url","label":"Link"}]}],"presets":[{"name":"Accessory grid","blocks":[{"type":"category","settings":{"title":"Tumblers","copy":"Engraved drinkware for crews, gifts and events."}},{"type":"category","settings":{"fallback":"keychains.png","title":"Keychains","copy":"Compact branded pieces for add-ons and customer gifts."}},{"type":"category","settings":{"title":"Can Dusters","copy":"Branded beverage accessories for events and team orders."}},{"type":"category","settings":{"title":"Journals","copy":"Useful employee and customer gifts."}},{"type":"category","settings":{"title":"Coasters","copy":"A practical engraved brand touchpoint."}},{"type":"category","settings":{"title":"Hat Tags","copy":"Coordinated presentation details for finished hats."}}]}]}{% endschema %}
