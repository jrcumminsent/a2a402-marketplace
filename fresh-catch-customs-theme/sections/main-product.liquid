<section class="section"><div class="container">{% render 'breadcrumbs' %}<div class="product-main"><div class="gallery"><div class="gallery__thumbs">{% for media in product.media %}<button type="button" aria-label="View {{ media.alt | default: product.title }}">{{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: media.alt }}</button>{% endfor %}</div><div>{% for media in product.media limit: 1 %}{{ media.preview_image | image_url: width: 1400 | image_tag: widths: '550,750,1100,1400', alt: media.alt | default: product.title }}{% endfor %}</div></div>
<div class="sticky-buy"><p class="eyebrow">{{ product.type }}</p><h1 style="font-size:clamp(3rem,6vw,5rem)">{{ product.title }}</h1><p>{{ product.price | money }}</p>
{% assign is_custom = product.metafields.custom.quote_only.value | default: false %}
{% if is_custom %}<p>This product requires artwork, model, color, quantity and patch review before purchase.</p><a class="button mobile-sticky" href="/pages/custom-hats#custom-order-form">Start a Custom Order</a>
{% else %}{% form 'product', product, class: 'js-loading-form' %}{% unless product.has_only_default_variant %}{% for option in product.options_with_values %}<div class="field"><label for="Option-{{ forloop.index }}">{{ option.name }}</label><select id="Option-{{ forloop.index }}" name="options[{{ option.name | escape }}]">{% for value in option.values %}<option value="{{ value | escape }}">{{ value }}</option>{% endfor %}</select></div>{% endfor %}{% endunless %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><div class="field"><label for="Quantity">Quantity</label><input id="Quantity" class="quantity" name="quantity" type="number" min="1" value="1"></div><button class="button mobile-sticky" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to Cart{% else %}Sold Out{% endif %}</button>{% endform %}{% endif %}
<div class="accordion"><details open><summary>Product notes</summary>{{ product.description }}</details><details><summary>Materials</summary><p>{{ product.metafields.custom.material_details | default: 'See product description or contact Fresh Catch for material details.' }}</p></details><details><summary>Shipping</summary><p>Ready-made inventory can use standard checkout. Custom items require artwork and production confirmation before fulfillment.</p></details></div></div></div></div></section>
{% schema %}{"name":"Main product","settings":[]}{% endschema %}
