<section class="section"><div class="container"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><p class="lede">{{ section.settings.copy }}</p><div class="grid grid--2">
  {% for block in section.blocks %}{% render 'hat-model-card', model: block.settings.model, title: block.settings.title, description: block.settings.description, bullets: block.settings.features, button_label: block.settings.button_label, button_url: block.settings.button_url %}{% endfor %}
</div></div></section>
{% schema %}{"name":"Hat model comparison","max_blocks":2,"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Launch collection"},{"type":"text","id":"heading","label":"Heading","default":"Choose Your Hat"},{"type":"textarea","id":"copy","label":"Copy","default":"Start with one of two approved Richardson models. Specifications and available colors remain editable."}],"blocks":[{"type":"model","name":"Hat model","settings":[{"type":"text","id":"model","label":"Model"},{"type":"text","id":"title","label":"Title"},{"type":"textarea","id":"description","label":"Description"},{"type":"richtext","id":"features","label":"Verified features"},{"type":"text","id":"button_label","label":"Button label"},{"type":"url","id":"button_url","label":"Button link"}]}],"presets":[{"name":"Hat model comparison","blocks":[{"type":"model","settings":{"model":"Richardson 112","title":"The Classic Trucker","description":"A structured trucker-hat direction with a mesh back, snapback closure and familiar everyday shape.","features":"<ul><li>Structured profile</li><li>Mesh back</li><li>Snapback closure</li><li>Approved colors confirmed during quoting</li></ul>","button_label":"Customize a Richardson 112"}},{"type":"model","settings":{"model":"Richardson PTS30","title":"The Performance Option","description":"A lightweight, athletic direction for teams, outdoor work and active use. Final technical details are merchant-editable pending approval.","features":"<ul><li>Performance-oriented construction</li><li>Athletic fit</li><li>Approved colors confirmed during quoting</li></ul>","button_label":"Customize a Richardson PTS30"}}]}]}{% endschema %}
