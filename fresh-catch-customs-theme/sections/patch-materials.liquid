<section class="section section--dark"><div class="container"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><div class="grid grid--4">{% for block in section.blocks %}{% render 'material-card', image: block.settings.image, fallback_asset: block.settings.fallback, title: block.settings.title, guidance: block.settings.guidance, description: block.settings.description, url: block.settings.url %}{% endfor %}</div></div></section>
{% schema %}{"name":"Patch materials","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Material library"},{"type":"text","id":"heading","label":"Heading","default":"Choose Your Patch"}],"blocks":[{"type":"material","name":"Material","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"fallback","label":"Fallback asset filename","default":"material-samples.png"},{"type":"text","id":"title","label":"Title"},{"type":"text","id":"guidance","label":"Best-use guidance"},{"type":"textarea","id":"description","label":"Description"},{"type":"url","id":"url","label":"Link"}]}],"presets":[{"name":"Patch materials","blocks":[{"type":"material","settings":{"title":"Genuine Leather","guidance":"Natural, engraved finish","description":"Natural grain and rich engraving for an outdoors-inspired presentation."}},{"type":"material","settings":{"title":"Leatherette","guidance":"Broad color selection","description":"Color and texture choices suited to crisp, durable logo work."}},{"type":"material","settings":{"title":"UV Full Color","guidance":"Detailed multicolor artwork","description":"A strong route for flags, gradients and artwork that needs color beyond engraving."}},{"type":"material","settings":{"title":"Acrylic","guidance":"Confirm availability","description":"A clean dimensional patch option; colors and production details are confirmed during quoting."}}]}]}{% endschema %}
