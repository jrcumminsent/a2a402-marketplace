<footer class="footer"><div class="container footer__grid">
  <div><div class="logo"><img src="{{ 'fresh-catch-logo.png' | asset_url }}" alt="{{ shop.name }}" width="120" height="120"></div><p>{{ section.settings.copy }}</p>{% render 'social-icons' %}</div>
  {% for block in section.blocks %}<div {{ block.shopify_attributes }}><h3>{{ block.settings.title }}</h3>{% if block.settings.menu %}<ul>{% for link in block.settings.menu.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}</ul>{% else %}<div>{{ block.settings.text }}</div>{% endif %}</div>{% endfor %}
</div><div class="container"><small>© {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.tagline }}</small></div></footer>
{% schema %}{"name":"Premium footer","settings":[{"type":"textarea","id":"copy","label":"Brand copy","default":"Custom hats, patches, drinkware and branded goods built with clear choices and careful craftsmanship."},{"type":"text","id":"tagline","label":"Footer tagline","default":"Brand Better, Together."}],"blocks":[{"type":"menu","name":"Menu","settings":[{"type":"text","id":"title","label":"Title"},{"type":"link_list","id":"menu","label":"Menu"}]},{"type":"text","name":"Text","settings":[{"type":"text","id":"title","label":"Title"},{"type":"richtext","id":"text","label":"Text"}]}],"presets":[{"name":"Premium footer"}]}{% endschema %}
