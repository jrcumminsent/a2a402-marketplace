<section class="section"><div class="container"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><p class="lede">{{ section.settings.description }}</p><div class="product-grid">
{% if section.settings.collection != blank %}{% for product in section.settings.collection.products limit: section.settings.limit %}{% render 'product-card', product: product %}{% else %}<p>No products are currently available.</p>{% endfor %}{% else %}{% for i in (1..4) %}<article class="product-card">{{ 'product-' | append: i | placeholder_svg_tag }}<div class="product-card__body"><h3>Select a collection</h3><p>Products populate from Shopify.</p></div></article>{% endfor %}{% endif %}
</div>{% if section.settings.button_label != blank %}<div class="button-row">{% render 'button', label: section.settings.button_label, url: section.settings.button_url %}</div>{% endif %}</div></section>
{% schema %}{"name":"Featured products","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Ready to ship"},{"type":"text","id":"heading","label":"Heading","default":"Featured Hats"},{"type":"textarea","id":"description","label":"Description"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"limit","label":"Products","min":2,"max":12,"step":1,"default":4},{"type":"text","id":"button_label","label":"Button label","default":"Shop All Ready-to-Ship"},{"type":"url","id":"button_url","label":"Button link"}],"presets":[{"name":"Featured products"}]}{% endschema %}
