<section class="section" id="custom-order-form"><div class="container"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><p class="lede">{{ section.settings.copy }}</p>
{% form 'contact', id: 'CustomOrderForm', class: 'form-grid js-loading-form' %}
  {% if form.posted_successfully? %}<p class="form-status field--full" role="status">Thank you. Your request was sent successfully.</p>{% endif %}
  {% if form.errors %}<div class="field--full" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
  {% render 'form-field', id: 'custom-name', label: 'Customer name', name: 'contact[name]', required: true %}
  {% render 'form-field', id: 'custom-email', label: 'Email address', name: 'contact[email]', type: 'email', required: true %}
  {% render 'form-field', id: 'custom-phone', label: 'Phone number', name: 'contact[Phone]', type: 'tel' %}
  {% render 'form-field', id: 'custom-org', label: 'Business, team, or organization', name: 'contact[Organization]' %}
  <div class="field"><label for="custom-order-type">Order type *</label><select id="custom-order-type" name="contact[Order type]" required><option value="">Select</option><option>Individual custom hat</option><option>Bulk custom hats</option><option>Business branding</option><option>Event or team order</option></select></div>
  <div class="field"><label for="custom-model">Hat model *</label><select id="custom-model" name="contact[Hat model]" data-model-select required><option value="">Select</option><option value="Richardson 112">Richardson 112</option><option value="Richardson PTS30">Richardson PTS30</option></select></div>
  <div class="field" data-colors-for="Richardson 112" hidden><label for="color-112">Richardson 112 color *</label><select id="color-112" name="contact[Hat color]" required><option value="">Select approved color</option>{% for block in section.blocks %}{% if block.type == 'color_112' %}<option>{{ block.settings.name }}</option>{% endif %}{% endfor %}</select></div>
  <div class="field" data-colors-for="Richardson PTS30" hidden><label for="color-pts30">Richardson PTS30 color *</label><select id="color-pts30" name="contact[Hat color]" required><option value="">Select approved color</option>{% for block in section.blocks %}{% if block.type == 'color_pts30' %}<option>{{ block.settings.name }}</option>{% endif %}{% endfor %}</select></div>
  <div class="field"><label for="custom-material">Patch material *</label><select id="custom-material" name="contact[Patch material]" required><option value="">Select</option><option>Genuine Leather</option><option>Leatherette</option><option>UV Full Color</option><option>Acrylic</option></select></div>
  <div class="field"><label for="custom-shape">Patch shape</label><input id="custom-shape" name="contact[Patch shape]"></div>
  <div class="field"><label for="custom-placement">Patch placement</label><input id="custom-placement" name="contact[Patch placement]"></div>
  <div class="field"><label for="custom-quantity">Estimated quantity *</label><input id="custom-quantity" name="contact[Estimated quantity]" type="number" min="1" required></div>
  <div class="field"><label for="custom-date">Needed-by date</label><input id="custom-date" name="contact[Needed by]" type="date"></div>
  <div class="field"><label for="custom-artwork">Artwork status</label><select id="custom-artwork" name="contact[Artwork status]"><option>Logo ready</option><option>Needs cleanup</option><option>Needs design guidance</option></select></div>
  <div class="field"><label for="custom-fulfillment">Shipping or pickup preference</label><select id="custom-fulfillment" name="contact[Fulfillment]"><option>Shipping</option><option>Pickup</option><option>Not sure</option></select></div>
  <div class="field field--full"><label for="custom-upload">Logo or artwork</label><p id="upload-help">{{ section.settings.upload_note }}</p>{% if section.settings.upload_url != blank %}<a class="button button--ghost" href="{{ section.settings.upload_url }}" target="_blank" rel="noopener">Upload artwork securely</a>{% else %}<p><strong>Upload integration required.</strong> This theme does not display a file input that Shopify cannot retain.</p>{% endif %}</div>
  {% render 'form-field', id: 'custom-notes', label: 'Personalization notes and additional details', name: 'contact[body]', type: 'textarea', full: true, required: true %}
  <div class="field field--full"><label><input type="checkbox" name="contact[Consent]" value="Yes" required> I consent to being contacted about this request. *</label></div>
  <div class="field field--full"><button class="button" type="submit">Send Custom Order Request</button></div>
{% endform %}</div></section>
{% schema %}{"name":"Custom order form","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Request a quote"},{"type":"text","id":"heading","label":"Heading","default":"Start Your Custom Order"},{"type":"textarea","id":"copy","label":"Copy","default":"Tell Fresh Catch what you need. Final pricing, artwork and production details are confirmed before the order moves forward."},{"type":"url","id":"upload_url","label":"External secure artwork upload URL"},{"type":"textarea","id":"upload_note","label":"Upload note","default":"Artwork upload requires a configured Shopify Forms feature, app, secure upload provider, or custom backend."}],"blocks":[{"type":"color_112","name":"Richardson 112 color","settings":[{"type":"text","id":"name","label":"Approved color name"}]},{"type":"color_pts30","name":"Richardson PTS30 color","settings":[{"type":"text","id":"name","label":"Approved color name"}]}],"presets":[{"name":"Custom order form"}]}{% endschema %}
