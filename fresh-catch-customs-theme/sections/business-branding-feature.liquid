<section class="split section--dark"><div class="split__media">{% render 'responsive-image', image: section.settings.image, fallback_asset: 'business-branding.jpg', alt: section.settings.heading, width: 1536, height: 1024 %}</div><div class="split__content"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><div>{{ section.settings.copy }}</div><div class="button-row">{% render 'button', label: section.settings.primary_label, url: section.settings.primary_url %}{% render 'button', label: section.settings.secondary_label, url: section.settings.secondary_url, style: 'ghost' %}</div></div></section>
{% schema %}{"name":"Business branding feature","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Business Branding Program"},{"type":"text","id":"heading","label":"Heading","default":"One Brand. Everywhere It Shows Up."},{"type":"richtext","id":"copy","label":"Copy","default":"<p>Coordinate Richardson hats, drinkware, hat tags, keychains, journals, coasters, employee gear, customer gifts, event merchandise and promotional products around one clear visual direction.</p>"},{"type":"text","id":"primary_label","label":"Primary button","default":"Explore Business Branding"},{"type":"url","id":"primary_url","label":"Primary link"},{"type":"text","id":"secondary_label","label":"Secondary button","default":"Request a Branding Quote"},{"type":"url","id":"secondary_url","label":"Secondary link"}],"presets":[{"name":"Business branding feature"}]}{% endschema %}
