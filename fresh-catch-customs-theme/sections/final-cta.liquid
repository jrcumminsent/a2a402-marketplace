<section class="section section--dark"><div class="container"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><p class="lede">{{ section.settings.copy }}</p><div class="button-row">{% render 'button', label: section.settings.primary_label, url: section.settings.primary_url %}{% render 'button', label: section.settings.secondary_label, url: section.settings.secondary_url, style: 'ghost' %}</div></div></section>
{% schema %}{"name":"Final CTA","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Start the conversation"},{"type":"text","id":"heading","label":"Heading","default":"Ready to Build Something People Will Actually Wear?"},{"type":"textarea","id":"copy","label":"Copy","default":"Choose a Richardson 112 or Richardson PTS30, send your logo, estimated quantity, preferred colors and deadline, and Fresh Catch Customs will help build a clear custom quote."},{"type":"text","id":"primary_label","label":"Primary button","default":"Start a Custom Order"},{"type":"url","id":"primary_url","label":"Primary link"},{"type":"text","id":"secondary_label","label":"Secondary button","default":"Ask a Question"},{"type":"url","id":"secondary_url","label":"Secondary link"}],"presets":[{"name":"Final CTA"}]}{% endschema %}
