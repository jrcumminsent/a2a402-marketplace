<section class="hero" style="min-height:55vh">{% if section.settings.image %}{% render 'responsive-image', image: section.settings.image, eager: true, alt: section.settings.heading %}{% else %}<img class="hero__media" src="{{ section.settings.fallback | default: 'workshop-hero.png' | asset_url }}" alt="" width="1672" height="941">{% endif %}<div class="hero__content container"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h1>{{ section.settings.heading | default: page.title }}</h1><p class="lede">{{ section.settings.copy }}</p>{% if section.settings.button_label != blank %}{% render 'button', label: section.settings.button_label, url: section.settings.button_url %}{% endif %}</div></section>
{% schema %}{"name":"Page hero","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"fallback","label":"Fallback asset filename","default":"workshop-hero.png"},{"type":"text","id":"eyebrow","label":"Eyebrow"},{"type":"text","id":"heading","label":"Heading"},{"type":"textarea","id":"copy","label":"Copy"},{"type":"text","id":"button_label","label":"Button label"},{"type":"url","id":"button_url","label":"Button link"}],"presets":[{"name":"Page hero"}]}{% endschema %}
