<section class="section"><div class="container"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><p class="lede">{{ section.settings.copy }}</p><div class="grid grid--2">
{% for block in section.blocks %}<div class="table-wrap" {{ block.shopify_attributes }}><table class="price-table"><caption><h3>{{ block.settings.title }}</h3><p>{{ block.settings.note }}</p></caption><thead><tr><th scope="col">Quantity</th><th scope="col">Per item</th></tr></thead><tbody>
{% if block.settings.tier_1_qty != blank %}<tr><td>{{ block.settings.tier_1_qty }}</td><td>{{ block.settings.tier_1_price }}</td></tr>{% endif %}
{% if block.settings.tier_2_qty != blank %}<tr><td>{{ block.settings.tier_2_qty }}</td><td>{{ block.settings.tier_2_price }}</td></tr>{% endif %}
{% if block.settings.tier_3_qty != blank %}<tr><td>{{ block.settings.tier_3_qty }}</td><td>{{ block.settings.tier_3_price }}</td></tr>{% endif %}
{% if block.settings.tier_4_qty != blank %}<tr><td>{{ block.settings.tier_4_qty }}</td><td>{{ block.settings.tier_4_price }}</td></tr>{% endif %}
</tbody></table></div>{% endfor %}</div></div></section>
{% schema %}{"name":"Bulk pricing tables","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Current pricing"},{"type":"text","id":"heading","label":"Heading","default":"Bulk Pricing"},{"type":"textarea","id":"copy","label":"Copy","default":"Final totals can vary with artwork, tax, shipping, product color and fulfillment timing."}],"blocks":[{"type":"table","name":"Pricing table","settings":[{"type":"text","id":"title","label":"Product"},{"type":"textarea","id":"note","label":"Note"},{"type":"text","id":"tier_1_qty","label":"Tier 1 quantity"},{"type":"text","id":"tier_1_price","label":"Tier 1 price"},{"type":"text","id":"tier_2_qty","label":"Tier 2 quantity"},{"type":"text","id":"tier_2_price","label":"Tier 2 price"},{"type":"text","id":"tier_3_qty","label":"Tier 3 quantity"},{"type":"text","id":"tier_3_price","label":"Tier 3 price"},{"type":"text","id":"tier_4_qty","label":"Tier 4 quantity"},{"type":"text","id":"tier_4_price","label":"Tier 4 price"}]}],"presets":[{"name":"Bulk pricing tables","blocks":[{"type":"table","settings":{"title":"Richardson 112","note":"Exact model-specific pricing has not been approved. Request current pricing."}},{"type":"table","settings":{"title":"Richardson PTS30","note":"Exact model-specific pricing has not been approved. Request current pricing."}},{"type":"table","settings":{"title":"Basic Hat Pricing (existing 2026 sheet)","note":"Not assigned to a specific Richardson model.","tier_1_qty":"1–24","tier_1_price":"$30","tier_2_qty":"25–49","tier_2_price":"$28","tier_3_qty":"50–149","tier_3_price":"$25","tier_4_qty":"150+","tier_4_price":"$20"}},{"type":"table","settings":{"title":"Performance Line (existing 2026 sheet)","note":"Existing site label; model mapping requires client approval.","tier_1_qty":"1–24","tier_1_price":"$35","tier_2_qty":"25–49","tier_2_price":"$32","tier_3_qty":"50–99","tier_3_price":"$30","tier_4_qty":"100+","tier_4_price":"$28"}}]}]}{% endschema %}
