<header class="header">
  <div class="header__inner container">
    <a class="logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
      {% if settings.logo %}{{ settings.logo | image_url: width: 300 | image_tag: widths: '120,180,300', alt: shop.name }}{% else %}<img src="{{ 'fresh-catch-logo.png' | asset_url }}" width="120" height="120" alt="{{ shop.name }}">{% endif %}
    </a>
    <nav class="nav" aria-label="Primary">
      {% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}
      <a class="button" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}</a>
    </nav>
    <div class="header__icons">
      <a href="{{ routes.search_url }}" aria-label="Search">{% render 'icon', name: 'search' %}</a>
      {% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}" aria-label="Account">{% render 'icon', name: 'account' %}</a>{% endif %}
      <a href="{{ routes.cart_url }}" aria-label="Cart">{% render 'icon', name: 'cart' %}</a>
    </div>
    <button class="menu-toggle" data-menu-toggle aria-expanded="false" aria-controls="MobileMenu">Menu</button>
  </div>
  <nav id="MobileMenu" class="mobile-drawer" data-mobile-drawer aria-label="Mobile navigation">
    {% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}
    <a href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}</a>
    <a href="{{ routes.search_url }}">Search</a><a href="{{ routes.cart_url }}">Cart</a>
  </nav>
</header>
{% schema %}{"name":"Premium header","settings":[{"type":"link_list","id":"menu","label":"Menu","default":"main-menu"},{"type":"text","id":"cta_label","label":"CTA label","default":"Start a Custom Order"},{"type":"url","id":"cta_url","label":"CTA link"}]}{% endschema %}
