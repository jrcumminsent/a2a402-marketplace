<section class="section"><div class="container"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><div class="accordion">{% for block in section.blocks %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.question }}</summary><div>{{ block.settings.answer }}</div></details>{% endfor %}</div></div></section>
{% schema %}{"name":"FAQ","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Common questions"},{"type":"text","id":"heading","label":"Heading","default":"Before You Submit"}],"blocks":[{"type":"question","name":"Question","settings":[{"type":"text","id":"question","label":"Question"},{"type":"richtext","id":"answer","label":"Answer"}]}],"presets":[{"name":"FAQ","blocks":[{"type":"question","settings":{"question":"Which custom hat models are available?","answer":"<p>The launch custom-order program offers Richardson 112 and Richardson PTS30 only.</p>"}},{"type":"question","settings":{"question":"Do I need production-ready artwork?","answer":"<p>No. Send the clearest version you have and describe any cleanup or design guidance needed.</p>"}},{"type":"question","settings":{"question":"How is pricing confirmed?","answer":"<p>Fresh Catch reviews the model, quantity, color, patch, artwork, fulfillment and timing before providing a final quote.</p>"}}]}]}{% endschema %}
