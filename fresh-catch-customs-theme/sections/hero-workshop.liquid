<section class="hero">
  {% if section.settings.image %}{% render 'responsive-image', image: section.settings.image, eager: true, alt: section.settings.image.alt %}{% else %}<img class="hero__media" src="{{ 'workshop-hero.png' | asset_url }}" alt="Fresh Catch Customs workshop and custom hats" width="1672" height="941" fetchpriority="high">{% endif %}
  <div class="hero__content container"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h1>{{ section.settings.heading }}</h1><p class="lede">{{ section.settings.copy }}</p><div class="button-row">{% render 'button', label: section.settings.primary_label, url: section.settings.primary_url %}{% render 'button', label: section.settings.secondary_label, url: section.settings.secondary_url, style: 'ghost' %}</div><p>{{ section.settings.trust }}</p></div>
</section>
{% schema %}{"name":"Workshop hero","settings":[{"type":"image_picker","id":"image","label":"Background image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Fresh Catch Customs"},{"type":"textarea","id":"heading","label":"Heading","default":"CUSTOM HATS. BUILT FOR YOUR BRAND."},{"type":"textarea","id":"copy","label":"Copy","default":"Premium patch hats built on Richardson 112 and Richardson PTS30 blanks, customized around your logo, business, team, event, or idea."},{"type":"text","id":"primary_label","label":"Primary button","default":"Start a Custom Order"},{"type":"url","id":"primary_url","label":"Primary link"},{"type":"text","id":"secondary_label","label":"Secondary button","default":"Shop Ready-to-Ship"},{"type":"url","id":"secondary_url","label":"Secondary link"},{"type":"text","id":"trust","label":"Trust line","default":"Richardson 112 · Richardson PTS30 · Custom Patches · Bulk Orders"}],"presets":[{"name":"Workshop hero"}]}{% endschema %}
