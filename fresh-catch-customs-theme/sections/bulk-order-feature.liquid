<section class="split"><div class="split__content"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><div>{{ section.settings.copy }}</div><div class="button-row">{% render 'button', label: section.settings.primary_label, url: section.settings.primary_url %}{% render 'button', label: section.settings.secondary_label, url: section.settings.secondary_url, style: 'ghost' %}</div></div><div class="split__media">{% render 'responsive-image', image: section.settings.image, fallback_asset: 'bulk-orders.png', alt: 'Rows of completed Fresh Catch custom hats for a bulk order', width: 1672, height: 941 %}</div></section>
{% schema %}{"name":"Bulk order feature","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Quantity pricing"},{"type":"text","id":"heading","label":"Heading","default":"Built for Crews, Teams, Events and Businesses."},{"type":"richtext","id":"copy","label":"Copy","default":"<p>Quantity pricing is available for Richardson 112 and Richardson PTS30 custom hats, with coordinated patch materials, artwork guidance and deadline planning.</p>"},{"type":"text","id":"primary_label","label":"Primary button","default":"View Bulk Pricing"},{"type":"url","id":"primary_url","label":"Primary link"},{"type":"text","id":"secondary_label","label":"Secondary button","default":"Request a Bulk Quote"},{"type":"url","id":"secondary_url","label":"Secondary link"}],"presets":[{"name":"Bulk order feature"}]}{% endschema %}
