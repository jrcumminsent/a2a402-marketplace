<section class="section{% if section.settings.dark %} section--dark{% endif %}"><div class="container richtext"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><div>{{ section.settings.content }}</div>{% if section.settings.button_label != blank %}{% render 'button', label: section.settings.button_label, url: section.settings.button_url %}{% endif %}</div></section>
{% schema %}{"name":"Rich content","settings":[{"type":"checkbox","id":"dark","label":"Dark background","default":false},{"type":"text","id":"eyebrow","label":"Eyebrow"},{"type":"text","id":"heading","label":"Heading"},{"type":"richtext","id":"content","label":"Content"},{"type":"text","id":"button_label","label":"Button label"},{"type":"url","id":"button_url","label":"Button link"}],"presets":[{"name":"Rich content"}]}{% endschema %}
