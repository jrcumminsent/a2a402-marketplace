<section class="section"><div class="container split"><div class="split__media">{% render 'responsive-image', image: section.settings.image, fallback_asset: 'workshop-hero.png', alt: section.settings.heading, width: 1672, height: 941 %}</div><div class="split__content"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><div>{{ section.settings.copy }}</div></div></div></section>
