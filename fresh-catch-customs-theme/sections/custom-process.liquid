<section class="section"><div class="container"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><div class="process">{% for block in section.blocks %}<article class="process__item"><div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.copy }}</p></div></article>{% endfor %}</div>{% render 'button', label: section.settings.button_label, url: section.settings.button_url %}</div></section>
{% schema %}{"name":"Custom process","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"How it works"},{"type":"text","id":"heading","label":"Heading","default":"Your Logo. A Clear Build Plan."},{"type":"text","id":"button_label","label":"Button label","default":"Start Your Custom Order"},{"type":"url","id":"button_url","label":"Button link"}],"blocks":[{"type":"step","name":"Step","limit":5,"settings":[{"type":"text","id":"title","label":"Title"},{"type":"textarea","id":"copy","label":"Copy"}]}],"presets":[{"name":"Custom process","blocks":[{"type":"step","settings":{"title":"Choose the Hat","copy":"Select Richardson 112 or Richardson PTS30."}},{"type":"step","settings":{"title":"Choose the Color","copy":"Select from currently approved colors for that model."}},{"type":"step","settings":{"title":"Choose the Patch","copy":"Select the patch material, shape and placement."}},{"type":"step","settings":{"title":"Send the Artwork","copy":"Upload the logo through the configured upload service or describe the design."}},{"type":"step","settings":{"title":"Review the Quote","copy":"Confirm details, pricing, artwork and production plan."}}]}]}{% endschema %}
