<section class="section section--dark"><div class="container"><div class="grid grid--2">{% for block in section.blocks %}<article class="media-card" {{ block.shopify_attributes }}>{% render 'responsive-image', image: block.settings.image, fallback_asset: block.settings.fallback, alt: block.settings.title, width: 1672, height: 941 %}<div class="media-card__content"><h2>{{ block.settings.title }}</h2><p>{{ block.settings.copy }}</p>{% render 'button', label: block.settings.label, url: block.settings.url, style: 'ghost' %}</div></article>{% endfor %}</div></div></section>
{% schema %}{"name":"Shop paths","max_blocks":2,"settings":[],"blocks":[{"type":"path","name":"Path","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"fallback","label":"Fallback asset filename"},{"type":"text","id":"title","label":"Title"},{"type":"textarea","id":"copy","label":"Copy"},{"type":"text","id":"label","label":"Button label"},{"type":"url","id":"url","label":"Link"}]}],"presets":[{"name":"Shop paths","blocks":[{"type":"path","settings":{"fallback":"hat-samples.png","title":"Custom Hats","copy":"Choose a Richardson 112 or Richardson PTS30, select your patch material, and submit your logo.","label":"Build Your Custom Hat"}},{"type":"path","settings":{"fallback":"premade-flag.jpg","title":"Ready-to-Ship","copy":"Shop completed Fresh Catch Customs designs without submitting custom artwork.","label":"Shop Pre-Made Hats"}}]}]}{% endschema %}
