{% liquid
  assign source = image
  assign eager = eager | default: false
  assign loading_value = 'lazy'
  assign fetch_value = 'auto'
  if eager
    assign loading_value = 'eager'
    assign fetch_value = 'high'
  endif
%}
{% if source %}
  {{ source | image_url: width: 2000 | image_tag: widths: '375,550,750,1100,1500,2000', sizes: sizes | default: '100vw', loading: loading_value, fetchpriority: fetch_value, alt: alt | escape }}
{% elsif fallback_asset %}
  <img src="{{ fallback_asset | asset_url }}" alt="{{ alt | escape }}" width="{{ width | default: 1600 }}" height="{{ height | default: 1000 }}" {% unless eager %}loading="lazy"{% endunless %}>
{% endif %}
