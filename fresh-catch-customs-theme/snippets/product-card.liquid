<article class="product-card">
  <a href="{{ product.url }}" class="product-card__image">
    {% if product.featured_image %}
      {{ product.featured_image | image_url: width: 800 | image_tag: widths: '320,480,640,800', sizes: '(min-width: 1024px) 25vw, 50vw', loading: 'lazy', alt: product.featured_image.alt | default: product.title }}
    {% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}
  </a>
  <div class="product-card__body">
    {% if product.available %}<span class="badge">Available</span>{% endif %}
    <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
    {% if product.type != blank %}<p>{{ product.type }}</p>{% endif %}
    <p><strong>{{ product.price | money }}</strong></p>
    <a class="button button--ghost" href="{{ product.url }}">View product</a>
  </div>
</article>
