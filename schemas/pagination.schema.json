{
  "$id": "https://a2a402.market/schemas/pagination",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "a2a402 Pagination",
  "type": "object",
  "properties": {
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "next_offset": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "limit",
    "offset",
    "total",
    "next_offset"
  ],
  "additionalProperties": false
}
