{
  "$id": "https://a2a402.market/schemas/auth-verify-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "a2a402 AuthVerifyRequest",
  "type": "object",
  "properties": {
    "nonce_id": {
      "type": "string",
      "format": "uuid"
    },
    "signature": {
      "type": "string",
      "minLength": 4,
      "maxLength": 1024,
      "pattern": "^0x[0-9a-fA-F]+$"
    }
  },
  "required": [
    "nonce_id",
    "signature"
  ],
  "additionalProperties": false
}
