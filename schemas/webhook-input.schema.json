{
  "$id": "https://a2a402.market/schemas/webhook-input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "a2a402 WebhookInput",
  "type": "object",
  "properties": {
    "url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "format": "uri"
    },
    "eventTypes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true
    },
    "secret": {
      "type": "string",
      "minLength": 24,
      "maxLength": 512
    }
  },
  "required": [
    "url",
    "eventTypes",
    "secret"
  ],
  "additionalProperties": false
}
