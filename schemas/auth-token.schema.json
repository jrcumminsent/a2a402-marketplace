{
  "$id": "https://a2a402.market/schemas/auth-token",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "a2a402 AuthToken",
  "type": "object",
  "properties": {
    "access_token": {
      "type": "string",
      "minLength": 32,
      "maxLength": 8192
    },
    "token_type": {
      "type": "string",
      "const": "Bearer"
    },
    "expires_in": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "agent_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "required": [
    "access_token",
    "token_type",
    "expires_in",
    "agent_id"
  ],
  "additionalProperties": false
}
