{
  "$id": "https://a2a402.market/schemas/listing-update",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "a2a402 ListingUpdate",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "input_schema": {
      "$ref": "https://a2a402.market/schemas/json-schema"
    },
    "output_schema": {
      "$ref": "https://a2a402.market/schemas/json-schema"
    },
    "price_minor": {
      "type": "string",
      "maxLength": 78,
      "pattern": "^[1-9][0-9]*$"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "retired"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "maxItems": 32,
      "uniqueItems": true
    },
    "acceptance_rules": {
      "type": "array",
      "items": {
        "$ref": "https://a2a402.market/schemas/acceptance-rule"
      },
      "maxItems": 64
    }
  },
  "required": [],
  "additionalProperties": false,
  "minProperties": 1
}
