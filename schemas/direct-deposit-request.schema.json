{
  "$id": "https://a2a402.market/schemas/direct-deposit-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "a2a402 DirectDepositRequest",
  "type": "object",
  "properties": {
    "amount_minor": {
      "type": "string",
      "maxLength": 78,
      "pattern": "^[1-9][0-9]*$"
    },
    "asset": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "origin_type": {
      "type": "string",
      "enum": [
        "human_seeded",
        "unknown"
      ]
    },
    "source_transaction_hash": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "amount_minor",
    "origin_type"
  ],
  "additionalProperties": false
}
