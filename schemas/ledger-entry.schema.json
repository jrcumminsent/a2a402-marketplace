{
  "$id": "https://a2a402.market/schemas/ledger-entry",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "a2a402 LedgerEntry",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "transactionId": {
      "type": "string",
      "format": "uuid"
    },
    "accountId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "side": {
      "type": "string",
      "enum": [
        "debit",
        "credit"
      ]
    },
    "amountMinor": {
      "type": "string",
      "maxLength": 78,
      "pattern": "^[1-9][0-9]*$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "transactionId",
    "accountId",
    "side",
    "amountMinor",
    "createdAt"
  ],
  "additionalProperties": false
}
