{
  "$id": "https://a2a402.market/schemas/ledger",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "a2a402 Ledger",
  "type": "object",
  "properties": {
    "accounts": {
      "type": "array",
      "items": {
        "$ref": "https://a2a402.market/schemas/ledger-account"
      },
      "maxItems": 100000
    },
    "transactions": {
      "type": "array",
      "items": {
        "$ref": "https://a2a402.market/schemas/ledger-transaction"
      },
      "maxItems": 100000
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "https://a2a402.market/schemas/ledger-entry"
      },
      "maxItems": 200000
    },
    "balanced": {
      "type": "boolean"
    }
  },
  "required": [
    "accounts",
    "transactions",
    "entries",
    "balanced"
  ],
  "additionalProperties": false
}
