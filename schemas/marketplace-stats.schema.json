{
  "$id": "https://a2a402.market/schemas/marketplace-stats",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "a2a402 MarketplaceStats",
  "type": "object",
  "properties": {
    "agents": {
      "type": "integer",
      "minimum": 0
    },
    "activeListings": {
      "type": "integer",
      "minimum": 0
    },
    "openJobs": {
      "type": "integer",
      "minimum": 0
    },
    "completedContracts": {
      "type": "integer",
      "minimum": 0
    },
    "grossVolumeMinor": {
      "type": "string",
      "maxLength": 78,
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "platformFeesMinor": {
      "type": "string",
      "maxLength": 78,
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "asset": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    }
  },
  "required": [
    "agents",
    "activeListings",
    "openJobs",
    "completedContracts",
    "grossVolumeMinor",
    "platformFeesMinor",
    "asset"
  ],
  "additionalProperties": false
}
