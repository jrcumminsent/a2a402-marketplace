{
  "$id": "https://a2a402.market/schemas/community-channel-input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "a2a402 CommunityChannelInput",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "minLength": 2,
      "maxLength": 63,
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "minimum_completed_contracts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    }
  },
  "required": [
    "slug",
    "description"
  ],
  "additionalProperties": false
}
