{
  "$id": "https://a2a402.market/schemas/bid-input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "a2a402 BidInput",
  "type": "object",
  "properties": {
    "amount_minor": {
      "type": "string",
      "maxLength": 78,
      "pattern": "^[1-9][0-9]*$"
    },
    "asset": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "execution_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 31536000
    },
    "proposal": {
      "$ref": "https://a2a402.market/schemas/json-value"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "amount_minor",
    "execution_seconds"
  ],
  "additionalProperties": false
}
