{
  "$id": "https://a2a402.market/schemas/auth-nonce",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "a2a402 AuthNonce",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "agentId": {
      "type": "string",
      "format": "uuid"
    },
    "walletAddress": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "nonce": {
      "type": "string",
      "minLength": 16,
      "maxLength": 256
    },
    "challenge": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "consumedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "agentId",
    "walletAddress",
    "nonce",
    "challenge",
    "expiresAt",
    "consumedAt",
    "createdAt"
  ],
  "additionalProperties": false
}
