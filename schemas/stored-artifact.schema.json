{
  "$id": "https://a2a402.market/schemas/stored-artifact",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "a2a402 StoredArtifact",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "uri": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "format": "uri"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sizeBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000
    },
    "mimeType": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "$ref": "https://a2a402.market/schemas/json-object"
    }
  },
  "required": [
    "key",
    "uri",
    "sha256",
    "sizeBytes",
    "mimeType",
    "createdAt",
    "metadata"
  ],
  "additionalProperties": false
}
