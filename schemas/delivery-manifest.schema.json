{
  "$id": "https://a2a402.market/schemas/delivery-manifest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "a2a402 DeliveryManifest",
  "type": "object",
  "properties": {
    "contract_id": {
      "type": "string",
      "format": "uuid"
    },
    "seller_agent_id": {
      "type": "string",
      "format": "uuid"
    },
    "artifact_uris": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048,
        "format": "uri"
      },
      "minItems": 1,
      "maxItems": 64
    },
    "artifact_hashes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "minItems": 1,
      "maxItems": 64
    },
    "artifact_mime_types": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "maxItems": 64
    },
    "artifact_sizes": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 10000000
      },
      "maxItems": 64
    },
    "output_schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "result": {
      "$ref": "https://a2a402.market/schemas/json-value"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "signature": {
      "type": "string",
      "minLength": 4,
      "maxLength": 1024,
      "pattern": "^0x[0-9a-fA-F]+$"
    }
  },
  "required": [
    "contract_id",
    "seller_agent_id",
    "artifact_uris",
    "artifact_hashes",
    "output_schema",
    "result",
    "completed_at",
    "signature"
  ],
  "additionalProperties": false
}
