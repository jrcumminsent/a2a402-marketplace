PORT=3000
APP_BASE_URL=https://a2a402.market
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
A2A402_PAYMENT_PROVIDER=onchain
A2A402_NETWORK=base
A2A402_ASSET=A2A
A2A402_ENABLE_LOUNGE=true

# A2A production token on Base Mainnet.
A2A402_TOKEN_ENABLED=true
A2A402_TOKEN_CHAIN=base
A2A402_TOKEN_CHAIN_ID=8453
A2A402_TOKEN_SYMBOL=A2A
A2A402_TOKEN_DECIMALS=18
A2A402_TOKEN_ADDRESS=0xF2bb6DC14E9097EC08F9Eaa9C6B7d39662195F01
A2A402_BASE_MAINNET_RPC_URL=https://mainnet.base.org

# Public wallet that receives the A2A402 5% marketplace fee.
# Never put a private key or seed phrase here.
A2A402_TREASURY_ADDRESS=0xD08eA67ef730fc336a9B6fB89A4B66dF67Fbb69c
A2A402_MARKETPLACE_FEE_BPS=500
A2A402_MAINNET_SETTLEMENT_ENABLED=true
A2A402_REAL_MONEY_ENABLED=true

# Optional payer-agent autonomous executor (scripts/a2a-payment-executor.mjs).
# The signer RPC must be controlled by the payer agent. A2A402 never receives its private key.
A2A402_AGENT_ID=
A2A402_AUTH_TOKEN=
A2A402_SIGNER_RPC_URL=
A2A402_SIGNER_FROM=
A2A402_EXPECTED_TOKEN_ADDRESS=0xF2bb6DC14E9097EC08F9Eaa9C6B7d39662195F01
A2A402_EXPECTED_TREASURY_ADDRESS=0xD08eA67ef730fc336a9B6fB89A4B66dF67Fbb69c
# Strongly recommended: set a per-job spending ceiling in A2A base units.
A2A402_MAX_PER_JOB_UNITS=
A2A402_EXECUTOR_POLL_MS=60000
A2A402_EXECUTOR_STATE_FILE=.a2a402-payment-executor-state.json

# Legacy Base Sepolia test environment. Keep available for regression testing only.
A2A402_BASE_SEPOLIA_CHAIN_ID=84532
A2A402_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
A2A402_TEST_TOKEN_ADDRESS=0xF2bb6DC14E9097EC08F9Eaa9C6B7d39662195F01
