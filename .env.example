NODE_ENV=development
HOST=0.0.0.0
PORT=3000
APP_BASE_URL=http://localhost:3000
PUBLIC_MARKET_URL=http://localhost:3000

A2A402_IMAGE_TAG=local
A2A402_IMAGE_VERSION=0.1.0
A2A402_IMAGE_REVISION=local

# Host-run database and Redis URLs.
DATABASE_URL=postgresql://a2a402:a2a402_local_only@localhost:5432/a2a402
REDIS_URL=redis://localhost:6379

# Compose containers use service DNS names. Override these only when Compose
# connects to managed infrastructure.
COMPOSE_APP_BASE_URL=http://localhost:3000
COMPOSE_PUBLIC_MARKET_URL=http://localhost:3000
COMPOSE_DATABASE_URL=postgresql://a2a402:a2a402_local_only@postgres:5432/a2a402
COMPOSE_REDIS_URL=redis://redis:6379

# Generate unique development values. Never reuse these in production.
JWT_SECRET=
SIGNING_PRIVATE_KEY=
SIGNING_KEY_ID=
ADMIN_EMERGENCY_KEY=

PAYMENTS_MODE=mock
ALLOW_SIMULATION_MODE=false
ENABLE_MAINNET=false
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_NETWORK=eip155:84532
X402_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e
BASE_SEPOLIA_RPC_URL=
PLATFORM_SETTLEMENT_ADDRESS=
PLATFORM_FEE_BPS=500

# Comma-separated, deployment-approved attestation issuer identifiers.
EXTERNAL_EARNING_ISSUER_ALLOWLIST=

ARTIFACT_STORAGE_MODE=local
ARTIFACT_STORAGE_PATH=./data/artifacts
# Standalone S3-compatible deployments configure these values. Netlify
# Functions must not set them for Netlify Blobs; the runtime injects site ID
# and short-lived access credentials automatically for each invocation.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

MAX_JOB_AMOUNT_MINOR=100000000
MAX_AGENT_DAILY_SPEND_MINOR=250000000
MAX_ARTIFACT_BYTES=10000000
COMMUNITY_MESSAGES_PER_MINUTE=30
AUTH_NONCE_TTL_SECONDS=300
AUTH_TOKEN_TTL_SECONDS=900
LOG_LEVEL=info

# API containers leave autonomous loops off; the dedicated Compose worker
# overrides this when the "workers" profile is enabled.
BACKGROUND_WORKERS_ENABLED=false
WORKER_INTERVAL_MS=5000

# Required before storing encrypted webhook secrets. There is no safe default.
WEBHOOK_SECRET_ENCRYPTION_KEY=

# Registration notifications. The recipient defaults to
# jrcumminsent@gmail.com; override only when intentionally transferring
# operational ownership. The provider key and verified sender are required.
AGENT_SIGNUP_NOTIFY_TO=jrcumminsent@gmail.com
AGENT_SIGNUP_NOTIFY_FROM=
RESEND_API_KEY=

# Official A2A402 Moltbook beacon agent. Disabled and approval-gated by default.
MOLTBOOK_AGENT_ENABLED=false
MOLTBOOK_REQUIRE_APPROVAL=true
MOLTBOOK_API_KEY=
MOLTBOOK_CREDENTIALS_PATH=./data/moltbook-agent/credentials.json
MOLTBOOK_STATE_PATH=./data/moltbook-agent/state.json
MOLTBOOK_MAX_POSTS_PER_DAY=1
MOLTBOOK_MAX_REPLIES_PER_DAY=5
MOLTBOOK_SAME_ACCOUNT_COOLDOWN_HOURS=24
