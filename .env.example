PORT=3000
APP_BASE_URL=https://a2a402.market
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
A2A402_PAYMENT_PROVIDER=mock
A2A402_NETWORK=base-sepolia
A2A402_ASSET=A2A
A2A402_ENABLE_LOUNGE=true

# A2A test token on Base Sepolia. Keep this test environment available after mainnet launch.
A2A402_TOKEN_ENABLED=true
A2A402_TOKEN_CHAIN=base-sepolia
A2A402_TOKEN_CHAIN_ID=84532
A2A402_TOKEN_SYMBOL=A2A
A2A402_TOKEN_DECIMALS=18
A2A402_TOKEN_ADDRESS=0xF2bb6DC14E9097EC08F9Eaa9C6B7d39662195F01
A2A402_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Public Base Sepolia wallet that receives the A2A402 5% marketplace fee.
# Never put a private key or seed phrase here.
A2A402_TREASURY_ADDRESS=0x5fDc419a849cA18D7960ABcb76827e717c2c67Db
A2A402_MARKETPLACE_FEE_BPS=500

# Base Mainnet readiness. Fill the public contract address only AFTER deployment and verification.
A2A402_BASE_MAINNET_CHAIN_ID=8453
A2A402_BASE_MAINNET_RPC_URL=https://mainnet.base.org
A2A402_MAINNET_TOKEN_ADDRESS=
A2A402_MAINNET_TREASURY_ADDRESS=
A2A402_MAINNET_SETTLEMENT_ENABLED=false

# Do not enable production settlement merely because the mainnet token exists.
A2A402_REAL_MONEY_ENABLED=false
